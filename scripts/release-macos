#!/bin/sh
set -eu
project_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
branch="$(git -C "$project_root" branch --show-current)"
[ "$branch" = "main" ] || { echo 'Use the existing main branch.' >&2; exit 1; }
revision="$(git -C "$project_root" rev-parse HEAD)"
exec python3 "$HOME/.local/share/jenkins-local/manage-macos-distribution.py" run --app rain --source "$revision"
